WG_HOST=your_server_ip
PASSWORD_HASH=your_bcrypt_hash
SECRET=need_generate
# Для генерации PASSWORD_HASH используйте: docker run --rm python:3.11-slim bash -c "pip install -q bcrypt && python -c 'import bcrypt; print(bcrypt.hashpw(b\"password\", bcrypt.gensalt(10)).decode())'"
# SECRET сгенерирован командой: openssl rand -hex 16
# Скопируйте .env_example в .env: cp .env_example .env